# =============================================================
# MUNDO INVEST — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais
# =============================================================

# URL do banco de dados
# SQLite local (padrão para desenvolvimento):
DATABASE_URL=sqlite:///./mundo_invest.db

# PostgreSQL via Docker (opcional):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mundo_invest

# ID do pipe no Pipefy onde os cards serão criados
# (encontrado na URL ao abrir o pipe: app.pipefy.com/pipes/<PIPE_ID>)
PIPEFY_PIPE_ID=pipe_mundo_invest_001

# Token de autenticação da API do Pipefy
# (gerado em: app.pipefy.com/tokens)
PIPEFY_TOKEN=seu_token_aqui
